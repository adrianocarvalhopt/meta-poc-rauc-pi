part /boot --source bootimg-partition --ondisk mmcblk${RPI_DISK_NUMBER} --fstype=vfat --label boot --active --align 4096 --size 100
part       --source bootimg-partition-x --sourceparams="slot=u-boot-n" --ondisk mmcblk${RPI_DISK_NUMBER} --fstype=vfat --label boot-a --align 4096 --size 100
part       --source bootimg-partition-x --sourceparams="slot=u-boot-n" --ondisk mmcblk${RPI_DISK_NUMBER} --fstype=vfat --label boot-b --align 4096 --size 100
part / --source rootfs --ondisk mmcblk${RPI_DISK_NUMBER} --fstype=ext4 --label rootfs_A --align 4096
part / --source rootfs --ondisk mmcblk${RPI_DISK_NUMBER} --fstype=ext4 --label rootfs_B --align 4096
part /data --source rootfs --rootfs-dir=${DEPLOY_DIR_IMAGE}/data-tree --ondisk mmcblk${RPI_DISK_NUMBER} --fstype=ext4 --label data --align 1024 --size 2000 --fsoptions "x-systemd.growfs"
