[system]
compatible=@@MACHINE@@
bootloader=uboot
data-directory=/data/

[keyring]
path=/etc/rauc/ca.cert.pem
 
[slot.rootfs.0]
device=/dev/mmcblk@@RPI_DISK_NUMBER@@p@@RAUCSLOT_A_PARTITION@@
type=ext4
bootname=A

[slot.rootfs.1]
device=/dev/mmcblk@@RPI_DISK_NUMBER@@p@@RAUCSLOT_B_PARTITION@@
type=ext4
bootname=B
